# Database
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ai_job_tracker

# JWT
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# AI provider: "gemini", "openai" or "mock"
# When set to gemini/openai and the matching key is empty, the app falls back
# to the mock provider so the product keeps working without an API key.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Frontend origin allowed by CORS
FRONTEND_URL=http://localhost:5173

# Set to true to expose verbose error details locally
DEBUG=true
